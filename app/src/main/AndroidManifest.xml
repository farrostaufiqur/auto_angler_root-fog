<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BotApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoAngler">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent activity to get MediaProjection consent -->
        <activity
            android:name=".MediaProjectionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Halaman log persisten -->
        <activity
            android:name=".LogActivity"
            android:exported="false" />

        <!-- Halaman info: nama app, fungsi, kredit -->
        <activity
            android:name=".AboutActivity"
            android:exported="false" />

        <!-- Varian ROOT-ONLY: tidak ada AccessibilityService. -->
        <service
            android:name=".overlay.OverlayService"
            android:foregroundServiceType="dataSync|mediaProjection"
            android:exported="false" />

    </application>
</manifest>
